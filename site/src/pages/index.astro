---
// Landing page — hero, features, CTA to /app/. SEO + AdSense content surface.
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";

const features = [
  { icon: "ruler", title: "Full 2D CAD", desc: "Lines, polylines, circles, arcs, constraints, dimensions. A real drafting workbench, not a viewer." },
  { icon: "file", title: "DWG & DXF native", desc: "Open and save DWG (R13–R2018) and DXF. Your drawings, your formats." },
  { icon: "bolt", title: "GPU-accelerated", desc: "WebGPU rendering with a WebGL2 fallback. Pan and zoom large drawings without lag." },
  { icon: "lock", title: "Local-first & private", desc: "Files never leave your device. Saved in your browser — no account, no upload." },
];

const icons: Record<string, string> = {
  ruler: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l14-14 4 4L7 21z"/><path d="M9 11l2 2M12 8l2 2M15 5l2 2"/></svg>',
  file: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l5 5v15H6z"/><path d="M14 2v6h6M9 13h6M9 17h6"/></svg>',
  bolt: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4 14h6l-1 8 9-12h-6z"/></svg>',
  lock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>',
};
---
<BaseLayout
  title="Free Browser CAD — DWG/DXF Editor, No Install"
  description="Open, edit, and export DWG and DXF files free in your browser. GPU-accelerated 2D CAD with no signup, no install, no accounts. Open source (GPL-3.0)."
>
  <section style="text-align:center; padding: 4rem 0 1.5rem;">
    <h1>Professional CAD.<br />In your browser. <span style="color:var(--accent)">Free.</span></h1>
    <p class="muted" style="font-size:1.15rem; max-width:640px; margin:0 auto;">
      Open, edit, and export DWG/DXF files instantly — no install, no signup,
      no license fees. Built with Rust and WebAssembly, rendered on your GPU.
    </p>
    <div style="display:flex; gap:1rem; justify-content:center; margin-top:2rem; flex-wrap:wrap;">
      <a class="btn" href="/app/">Start Drawing — it's free</a>
      <a class="btn ghost" href="/docs/getting-started/">Learn how it works</a>
      <a class="btn ghost" href="/tutorials/">Watch tutorials</a>
    </div>
    <p class="muted" style="font-size:0.85rem; margin-top:1rem;">
      No account required · Works offline · Open source (GPL-3.0)
    </p>
  </section>

  <AdSlot format="leaderboard" />

  <section>
    <h2 style="text-align:center;">Everything you need to draft</h2>
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:1.25rem; margin-top:1.5rem;">
      {
        features.map((f) => (
          <div style="background:var(--chrome); border:1px solid var(--border); border-radius:12px; padding:1.5rem;">
            <div
              aria-hidden="true"
              style="width:2rem; height:2rem; color:var(--accent);"
              set:html={icons[f.icon]}
            />
            <h3 style="margin:0.75rem 0 0.25rem;">{f.title}</h3>
            <p class="muted" style="margin:0; font-size:0.95rem;">{f.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section style="margin-top:3rem; background:var(--chrome); border:1px solid var(--border); border-radius:12px; padding:2rem; text-align:center;">
    <h2>Your next drawing is one click away.</h2>
    <p class="muted">No download. No installer. No trial-expired popups. Open the app and draw.</p>
    <a class="btn" href="/app/" style="margin-top:0.75rem;">Open Cadelo</a>
  </section>
</BaseLayout>

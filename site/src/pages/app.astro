---
// /app/ — host page: ad chrome + iframe to the isolated WASM app at /studio/.
// The app runs in an iframe so ads can never overlap the canvas, and COOP/COEP
// isolation applies only to /studio/* (ad scripts on this page stay compatible).
// Deliberately minimal: no toolbar/subtitle — the app frame spans the full
// page width so the canvas gets every pixel with ads still visible above and
// below (they are the revenue, never hidden). A drag handle under the frame
// lets the user resize its height; the choice persists in localStorage.
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
---

<BaseLayout
  title="Cadelo — Free Browser CAD App"
  description="Open, edit, and export DWG and DXF files free in your browser. No install, no signup, GPU-accelerated CAD app."
>
  <style is:global>
    /* Break out of BaseLayout's 1100px main column so the canvas spans
       the full viewport width (the point of a full-width CAD frame). */
    main {
      max-width: none !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
    .app-stage {
      width: 100%;
      max-width: none;
      margin: 0 auto;
    }
    .app-frame {
      width: 100%;
      height: calc(100vh - 240px);
      min-height: 400px;
      border: 1px solid var(--border);
      border-bottom: none;
      border-radius: 12px 12px 0 0;
      background: #1e1e1e;
      display: block;
    }
    /* Drag-to-resize handle under the frame. Overlays the frame's bottom
       edge so it reads as part of the app, not page chrome. */
    .app-resize {
      height: 12px;
      cursor: ns-resize;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      background: var(--chrome);
      border: 1px solid var(--border);
      border-top: none;
      border-radius: 0 0 12px 12px;
      touch-action: none;
      user-select: none;
      transition: background 0.15s ease;
    }
    .app-resize:hover {
      background: var(--border);
    }
    .app-resize .grip {
      width: 36px;
      height: 3px;
      border-radius: 2px;
      background: var(--muted);
      opacity: 0.7;
    }
    .app-resize:active .grip {
      background: var(--accent);
      opacity: 1;
    }
    body.resizing,
    body.resizing * {
      cursor: ns-resize !important;
      user-select: none !important;
    }
  </style>

  <div class="app-stage">
    <AdSlot format="leaderboard" />
    <iframe
      class="app-frame"
      id="app-frame"
      src="/studio/"
      title="Cadelo CAD app"
      allow="clipboard-write"
      loading="eager"
    ></iframe>
    <div class="app-resize" id="app-resize" title="Drag to resize the app" role="separator" aria-orientation="horizontal">
      <span class="grip"></span>
    </div>
    <AdSlot format="leaderboard" />
  </div>

  <script>
    // Drag-to-resize: pointer events (works for mouse + touch), clamps to a
    // sane minimum, persists the chosen height so reloads keep the layout.
    const frame = document.getElementById("app-frame");
    const handle = document.getElementById("app-resize");
    const MIN_H = 400;

    const saved = (() => {
      try {
        return parseInt(localStorage.getItem("cadelo-frame-h") || "", 10);
      } catch (_) {
        return NaN;
      }
    })();
    if (Number.isFinite(saved) && saved >= MIN_H) {
      frame.style.height = `${saved}px`;
    }

    let dragging = false;
    let startY = 0;
    let startH = 0;

    handle.addEventListener("pointerdown", (e) => {
      dragging = true;
      startY = e.clientY;
      startH = frame.getBoundingClientRect().height;
      handle.setPointerCapture(e.pointerId);
      document.body.classList.add("resizing");
      e.preventDefault();
    });

    handle.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const h = Math.max(MIN_H, startH + (e.clientY - startY));
      frame.style.height = `${h}px`;
    });

    const stop = () => {
      if (!dragging) return;
      dragging = false;
      document.body.classList.remove("resizing");
      try {
        localStorage.setItem("cadelo-frame-h", String(Math.round(frame.getBoundingClientRect().height)));
      } catch (_) {
        // storage unavailable (private mode etc.) — resize still works for the session
      }
    };
    handle.addEventListener("pointerup", stop);
    handle.addEventListener("pointercancel", stop);
  </script>
</BaseLayout>
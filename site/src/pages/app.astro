---
// /app/ — host page: ad chrome + iframe to the isolated WASM app at /studio/.
// The app runs in an iframe so ads can never overlap the canvas, and COOP/COEP
// isolation applies only to /studio/* (ad scripts on this page stay compatible).
// Deliberately minimal: no toolbar/subtitle — the app frame spans the full
// page width so the canvas gets every pixel with ads still visible above and
// below (they are the revenue, never hidden).
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
---

<BaseLayout
  title="Cadelo — Free Browser CAD App"
  description="Open, edit, and export DWG and DXF files free in your browser. No install, no signup, GPU-accelerated CAD app."
>
  <style is:global>
    /* Break out of BaseLayout's 1100px main column so the canvas spans
       the full viewport width (the point of a full-width CAD frame). */
    main {
      max-width: none !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
    .app-stage {
      width: 100%;
      max-width: none;
      margin: 0 auto;
    }
    .app-frame {
      width: 100%;
      height: calc(100vh - 240px);
      min-height: 600px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: #1e1e1e;
      display: block;
    }
  </style>

  <div class="app-stage">
    <AdSlot format="leaderboard" />
    <iframe
      class="app-frame"
      src="/studio/"
      title="Cadelo CAD app"
      allow="clipboard-write"
      loading="eager"
    ></iframe>
    <AdSlot format="leaderboard" />
  </div>
</BaseLayout>
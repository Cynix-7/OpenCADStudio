---
// /app/ — host page: ad chrome + iframe to the isolated WASM app at /studio/.
// The CAD app is desktop-only (mouse/keyboard precision work; no touch input
// support). The iframe's src is set only when a fine-pointer device is
// confirmed, so phones/tablets never download the 21 MB wasm — they see a
// desktop-only notice instead. Ads stay visible in both states.
// COOP/COEP isolation applies only to /studio/* (ad scripts stay compatible).
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
---

<BaseLayout
  title="Cadelo — Free Browser CAD App"
  description="Open, edit, and export DWG and DXF files free in your browser. No install, no signup, GPU-accelerated CAD app. Best on desktop."
>
  <style is:global>
    /* Break out of BaseLayout's 1100px main column so the canvas spans
       the full viewport width (the point of a full-width CAD frame). */
    main {
      max-width: none !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
    .app-stage {
      width: 100%;
      max-width: none;
      margin: 0 auto;
    }
    .app-frame {
      width: 100%;
      height: calc(100vh - 240px);
      min-height: 400px;
      border: 1px solid var(--border);
      border-bottom: none;
      border-radius: 12px 12px 0 0;
      background: #1e1e1e;
      display: block;
    }
    /* Drag-to-resize handle under the frame. Overlays the frame's bottom
       edge so it reads as part of the app, not page chrome. */
    .app-resize {
      height: 12px;
      cursor: ns-resize;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      background: var(--chrome);
      border: 1px solid var(--border);
      border-top: none;
      border-radius: 0 0 12px 12px;
      touch-action: none;
      user-select: none;
      transition: background 0.15s ease;
    }
    .app-resize:hover {
      background: var(--border);
    }
    .app-resize .grip {
      width: 36px;
      height: 3px;
      border-radius: 2px;
      background: var(--muted);
      opacity: 0.7;
    }
    .app-resize:active .grip {
      background: var(--accent);
      opacity: 1;
    }
    body.resizing,
    body.resizing * {
      cursor: ns-resize !important;
      user-select: none !important;
    }
    /* Desktop-only notice shown to touch/coarse-pointer devices. */
    .desktop-notice {
      background: var(--chrome);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 3rem 1.5rem;
      text-align: center;
      margin: 1.5rem 0;
      display: none;
    }
    [data-cadelo-app="unsupported"] .desktop-notice { display: block; }
    [data-cadelo-app="unsupported"] .app-frame,
    [data-cadelo-app="unsupported"] .app-resize { display: none; }
  </style>

  <div class="app-stage" id="app-stage">
    <AdSlot format="leaderboard" />

    <iframe
      class="app-frame"
      id="app-frame"
      title="Cadelo CAD app"
      allow="clipboard-write"
      loading="eager"
    ></iframe>

    <div class="app-resize" id="app-resize" title="Drag to resize the app" role="separator" aria-orientation="horizontal">
      <span class="grip"></span>
    </div>

    <div class="desktop-notice" role="status">
      <div style="font-size:2.25rem; margin-bottom:0.75rem;">🖥️</div>
      <h2 style="margin:0 0 0.5rem;">Cadelo is a desktop app</h2>
      <p class="muted" style="max-width:440px; margin:0 auto 1.5rem;">
        Drawing with precision needs a mouse and keyboard. Cadelo runs best in a
        desktop browser — open it on a laptop or desktop computer to start drafting.
      </p>
      <a class="btn ghost" href="/docs/getting-started/">Read the getting-started guide</a>
    </div>

    <AdSlot format="leaderboard" />
  </div>

  <script>
    // Device gate: the CAD app needs a precise pointer (mouse / trackpad).
    // Coarse-pointer devices (phones, tablets) get the desktop-only notice
    // and never load the 21 MB wasm. Surface-style laptops report a fine
    // primary pointer, so they load the app normally.
    const stage = document.getElementById("app-stage");
    const frame = document.getElementById("app-frame");

    const finePointer = (() => {
      try {
        const mq = window.matchMedia("(pointer: fine)");
        if (mq.matches) return true;
        // Very old browsers without the media query: fall back to touch
        // capability sniffing for the static demo/welcome surfaces.
        if (typeof mq.matches === "undefined") {
          return navigator.maxTouchPoints === 0;
        }
        return false;
      } catch (_) {
        return true;
      }
    })();

    if (finePointer) {
      // Desktop: boot the app.
      stage.dataset.cadeloApp = "supported";
      frame.src = "/studio/";
    } else {
      // Touch device: show the notice, never download the wasm.
      stage.dataset.cadeloApp = "unsupported";
    }

    // Drag-to-resize (desktop only): pointer events, clamps to a sane
    // minimum, persists the chosen height so reloads keep the layout.
    const handle = document.getElementById("app-resize");
    const MIN_H = 400;

    if (finePointer && handle && frame) {
      const saved = (() => {
        try {
          return parseInt(localStorage.getItem("cadelo-frame-h") || "", 10);
        } catch (_) {
          return NaN;
        }
      })();
      if (Number.isFinite(saved) && saved >= MIN_H) {
        frame.style.height = `${saved}px`;
      }

      let dragging = false;
      let startY = 0;
      let startH = 0;

      handle.addEventListener("pointerdown", (e) => {
        dragging = true;
        startY = e.clientY;
        startH = frame.getBoundingClientRect().height;
        handle.setPointerCapture(e.pointerId);
        document.body.classList.add("resizing");
        e.preventDefault();
      });

      handle.addEventListener("pointermove", (e) => {
        if (!dragging) return;
        const h = Math.max(MIN_H, startH + (e.clientY - startY));
        frame.style.height = `${h}px`;
      });

      const stop = () => {
        if (!dragging) return;
        dragging = false;
        document.body.classList.remove("resizing");
        try {
          localStorage.setItem("cadelo-frame-h", String(Math.round(frame.getBoundingClientRect().height)));
        } catch (_) {
          // storage unavailable (private mode etc.) — resize still works for the session
        }
      };
      handle.addEventListener("pointerup", stop);
      handle.addEventListener("pointercancel", stop);
    }
  </script>
</BaseLayout>
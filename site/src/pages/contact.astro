---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact" description="Contact OpenCAD Web — questions, bug reports, feedback.">
  <h1>Contact</h1>
  <p>
    Found a bug? Have a feature request? Want to report an issue with an ad?
    The fastest way to reach us is through GitHub:
  </p>
  <ul>
    <li>
      <a href="https://github.com/Cynix-7/OpenCADStudio/issues" target="_blank" rel="noopener">
        Open an issue on GitHub
      </a> — bugs, feature requests, and questions about the app
    </li>
    <li>
      <a href="https://github.com/Cynix-7/OpenCADStudio/discussions" target="_blank" rel="noopener">
        Start a discussion on GitHub
      </a> — general help and community chat
    </li>
  </ul>
  <h2>Advertising enquiries</h2>
  <p>
    We use Google AdSense for advertising. To report an inappropriate or misleading ad,
    use Google's
    <a href="https://support.google.com/adsense/troubleshooter/4573779" target="_blank" rel="noopener">
      AdSense ad complaint form
    </a>.
  </p>
  <h2>Privacy</h2>
  <p>See our <a href="/privacy/">privacy policy</a>.</p>
</BaseLayout>

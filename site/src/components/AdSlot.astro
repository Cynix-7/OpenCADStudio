---
// AdSlot.astro — CLS-safe ad placement.
// Renders a fixed min-height placeholder; AdSense <ins> fills it once the
// account is approved. When ads are blocked or the unit id is empty, the
// placeholder collapses to zero height (no layout shift, no broken layout).
interface Props {
  slot?: string; // AdSense slot id, e.g. "1234567890"
  client?: string; // AdSense client id, e.g. "ca-pub-1234567890"
  format?: "leaderboard" | "inarticle" | "responsive";
}
const { slot = "", client = "", format = "leaderboard" } = Astro.props;
const enabled = slot !== "" && client !== "";
const minHeight = format === "leaderboard" ? "90px" : format === "inarticle" ? "250px" : "90px";
---

<div
  class:list={["ad-slot", format]}
  style={`min-height: ${minHeight};`}
  data-ad-enabled={enabled}
>
  {enabled ? (
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={client}
      data-ad-slot={slot}
      data-ad-format={format === "leaderboard" ? "horizontal" : "auto"}
      data-full-width-responsive="true"
    />
  ) : (
    <span class="muted">Advertisement</span>
  )}
</div>

<script is:inline>
  // Push each enabled ad unit to render it. The site-wide adsbygoogle.js is
  // already loaded by BaseLayout.astro; this block only calls push().
  (() => {
    const slots = document.querySelectorAll(".ad-slot[data-ad-enabled='true'] .adsbygoogle");
    if (slots.length === 0) return;
    for (const slot of slots) {
      try {
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      } catch (_) {
        // Ad blocked / consent not granted — the slot keeps its placeholder.
      }
    }
  })();
</script>

<style>
  .ad-slot.inarticle { min-height: 250px; }
</style>
